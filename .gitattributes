# ------------------------------------------------------------------------------
# 1. Global / Default Behavior
# Auto-detect text files and normalize line endings to LF on check-in
* text=auto

# 2. Text / Source Code Files (Force LF line endings)
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.md      text eol=lf diff=markdown
*.txt     text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.go      text eol=lf
*.rs      text eol=lf
*.java    text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
# 3. Windows Specific Files (Force CRLF line endings)
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
# 4. Binary Files (Prevent line-ending conversion and diff generation)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.ttf     binary
# 5. Git LFS (Large File Storage) Tracking (Optional)
# *.psd   filter=lfs diff=lfs merge=lfs -text
# *.zip   filter=lfs diff=lfs merge=lfs -text
# *.mp4   filter=lfs diff=lfs merge=lfs -text
# 6. Archive / Export Exclusions
# Deny these metadata files from appearing in generated zip/tarball release exports
.gitattributes export-ignore
.gitignore     export-ignore
Content/Effects/Textures/Flipbooks/SmokeSwirl_3_Flipbook_CHANNELPACK.uasset filter=lfs diff=lfs merge=lfs -text
